# Dépendances et artefacts de construction
astro/node_modules/
astro/.astro/
astro/dist/
rust/target/

# Binaires et paquets : livrés par les releases, pas par git
rust/dist/
*.exe
*.AppImage
*.dmg

# Banc d'export : médias générés et sorties
rust/verify/
rust/scripts/media/

# Banc v1 : profils Chrome et rendus locaux
v1/tools/regression/media/
v1/tools/regression/out/
v1/tools/regression/.chrome-profile/
v1/_fx/chrome-profile-*/
v1/_fx/out/
v1/_fx/*.mp4

# Banc de régression v2, à la racine. Le profil Chrome local compte des
# centaines de fichiers (History, Cache, Cookies) : sans ces lignes, un envoi
# un peu large les committerait. `**/` couvre aussi les copies sous v1/.
tools/regression/media/
tools/regression/out/
**/.chrome-profile/
_fx/chrome-profile-*/
_fx/out/
_fx/*.mp4

# Divers
*.log
.DS_Store
Thumbs.db
