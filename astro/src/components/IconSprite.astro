  ['save', '<path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h8V3"/><path d="M8 21v-7h8v7"/>'],
  ['export', '<path d="M12 3v12"/><path d="M8 7l4-4 4 4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>'],
  ['import', '<path d="M12 15V3"/><path d="M8 11l4 4 4-4"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>'],
  ['media', '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9l5 3-5 3z"/>'],
  ['sliders', '<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="7" cy="18" r="2"/>'],
  ['wand', '<path d="M5 19L17 7"/><path d="M14 4l1.5 1.5M19 9l1.5 1.5M16 2l.5 2M21 6l2 .5"/>'],
  ['transition', '<path d="M3 6h7v12H3z"/><path d="M14 6h7v12h-7z"/><path d="M10 12h4"/>'],
  ['play', '<path d="M7 4l13 8-13 8z"/>'],
  ['pause', '<path d="M8 4v16M16 4v16"/>'],
  ['start', '<path d="M6 5v14"/><path d="M19 5L9 12l10 7z"/>'],
  ['end', '<path d="M18 5v14"/><path d="M5 5l10 7L5 19z"/>'],
  ['plus', '<path d="M12 5v14M5 12h14"/>'],
  ['minus', '<path d="M5 12h14"/>'],
  ['trash', '<path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/>'],
  ['duplicate', '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>'],
