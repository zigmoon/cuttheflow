---
/**
 * Jeu d'icônes du studio.
 *
 * Un seul sprite inline (aucune requête réseau) ; les composants référencent
 * `<use href="#i-nom">`. Traits de 1,6 px sur une grille 24 : c'est le poids
 * visuel des icônes de SuperPhoto, pour que les deux studios se ressemblent.
 */
interface Props {
  size?: number;
}
const { size = 15 } = Astro.props;
const icons: Array<[string, string]> = [
  ['new', '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M12 12v6M9 15h6"/>'],
