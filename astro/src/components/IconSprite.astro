  ['music', '<path d="M9 18V6l10-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>'],
  ['image', '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M4 17l5-5 4 4 3-3 4 4"/>'],
  ['eye', '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>'],
  ['undo', '<path d="M9 6L4 11l5 5"/><path d="M4 11h9a6 6 0 0 1 0 12h-2"/>'],
  ['redo', '<path d="M15 6l5 5-5 5"/><path d="M20 11h-9a6 6 0 0 0 0 12h2"/>'],
  ['zoom-in', '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/>'],
  ['zoom-out', '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M8 11h6"/>'],
  ['fit', '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>'],
  ['refresh', '<path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v5h-5"/>'],
  ['volume', '<path d="M4 10h3l4-3v10l-4-3H4z"/><path d="M15 9a4 4 0 0 1 0 6"/>'],
  ['sparkle', '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>'],
  ['folder', '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>'],
];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style={`position:absolute;width:0;height:0;overflow:hidden;pointer-events:none`}
>
  {icons.map(([name, body]) => (
    <symbol
      id={`i-${name}`}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={body}
    />
  ))}
</svg>
<span hidden data-icon-size={size}></span>
