  ['square', '<rect x="4" y="4" width="16" height="16" rx="2"/>'],
  ['circle', '<circle cx="12" cy="12" r="8"/>'],
  ['scissors', '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8 8l12 12M8 16L20 4"/>'],
  ['snap', '<path d="M6 4v9a4 4 0 0 0 4 4h1"/><path d="M6 4h4M14 17h4v4h-4z"/>'],
  ['sound', '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 8a5 5 0 0 1 0 8"/>'],
  ['mute', '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 9l4 6M21 9l-4 6"/>'],
  ['magnet', '<path d="M5 4v8a7 7 0 0 0 14 0V4h-4v8a3 3 0 0 1-6 0V4z"/>'],
